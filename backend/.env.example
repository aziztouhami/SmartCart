###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_this_to_a_random_string_in_production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
## Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
## For an SQLite database, use: "sqlite:///%kernel.project_dir%/var/data.db"
## For a PostgreSQL database, use: "postgresql://db_user:db_password@127.0.0.1:5432/db_name"
## IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
DATABASE_URL="postgresql://smartcart_user:smartcart_password@postgres:5432/smartcart_db?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> JWT Configuration ###
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800
###< JWT Configuration ###

###> CORS Configuration ###
CORS_ALLOW_ORIGIN=http://localhost:3000
###< CORS Configuration ###

###> API Configuration ###
API_URL=http://localhost:8000
API_VERSION=v1
###< API Configuration ###

###> Email Configuration ###
MAILER_DSN=smtp://mailer:1025
ADMIN_EMAIL=admin@smartcart.local
# Base URL used to build links inside emails (account confirmation, etc.)
FRONTEND_URL=http://localhost:3000
###< Email Configuration ###

###> Google OAuth ###
# Get a Client ID at https://console.cloud.google.com/apis/credentials
# Must match REACT_APP_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=
###< Google OAuth ###

###> PAYMENT Configuration (if needed) ###
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
###< PAYMENT Configuration ###

###> REDIS Configuration (for caching) ###
REDIS_URL=redis://redis:6379
###< REDIS Configuration ###

###> Application Configuration ###
APP_NAME=SmartCart
APP_TITLE="SmartCart - Intelligent E-Commerce Platform"
###< Application Configuration ###

###> Groq API Configuration ###
# Get a free key at https://console.groq.com/keys
# Used for the chatbot and the product-type attribute suggestion feature.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
###< Groq API Configuration ###

###> MyMemory Translation API ###
# Used to translate user messages to English before product keyword search.
# Enables the chatbot to understand French (or any language) queries and
# match them against English product/category names in the database.
# No account or credit card required.
#   - Leave empty  → 1 000 words/day (anonymous, sufficient for development)
#   - Set an email → 10 000 words/day (free, no credit card needed)
#     Register at: https://mymemory.translated.net/
MYMEMORY_EMAIL=
###< MyMemory Translation API ###
