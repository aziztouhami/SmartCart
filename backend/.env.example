###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_this_to_a_random_string_in_production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
## Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
## For an SQLite database, use: "sqlite:///%kernel.project_dir%/var/data.db"
## For a PostgreSQL database, use: "postgresql://db_user:db_password@127.0.0.1:5432/db_name"
## IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
## Matches docker-compose.yml's default postgres credentials (scu/scp/scdb) — only relevant for
## running the backend outside Docker; inside Docker this is overridden by the container's own
## DATABASE_URL environment variable regardless of what's set here.
DATABASE_URL="postgresql://scu:scp@postgres:5432/scdb?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> JWT Configuration ###
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=3600
###< JWT Configuration ###

###> CORS Configuration ###
CORS_ALLOW_ORIGIN=http://localhost:3000
###< CORS Configuration ###

###> Email Configuration ###
MAILER_DSN=smtp://mailer:1025
ADMIN_EMAIL=admin@smartcart.local
# Base URL used to build links inside emails (account confirmation, etc.)
FRONTEND_URL=http://localhost:3000
###< Email Configuration ###

###> Google OAuth ###
# Get a Client ID at https://console.cloud.google.com/apis/credentials
# Must match REACT_APP_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=
###< Google OAuth ###

###> Groq API Configuration ###
# Get a free key at https://console.groq.com/keys
# Used for the chatbot and the product-type attribute suggestion feature.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
###< Groq API Configuration ###

###> MyMemory Translation API ###
# Used to translate user messages to English before product keyword search.
# Enables the chatbot to understand French (or any language) queries and
# match them against English product/category names in the database.
# No account or credit card required.
#   - Leave empty  → 1 000 words/day (anonymous, sufficient for development)
#   - Set an email → 10 000 words/day (free, no credit card needed)
#     Register at: https://mymemory.translated.net/
MYMEMORY_EMAIL=
###< MyMemory Translation API ###

###> Ollama (local AI analytics) ###
# Powers the "Analyze" button in the admin panel (products/categories/brands/
# product types) — runs entirely locally via the "ollama" Docker service,
# nothing is sent to a cloud API.
#
# 1. Start it:  docker compose up -d ollama
# 2. Pull a model that fits your machine — see the model table in the README
#    (README.md → "Analytics IA locale (Ollama)"), e.g.:
#      docker exec smartcart_ollama ollama pull qwen3:8b
# 3. Set OLLAMA_MODEL below to whatever you pulled, then restart the backend.
#
# Left blank on purpose: which model to use is a hardware trade-off (RAM/CPU/
# GPU), so every developer picks their own rather than the repo dictating one.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
# Local CPU inference is much slower than a cloud API — raise this if you see
# timeouts with a larger model.
OLLAMA_TIMEOUT=120
###< Ollama (local AI analytics) ###
