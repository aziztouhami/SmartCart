REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_ENVIRONMENT=development
REACT_APP_DEBUG=true

# Google OAuth — must match GOOGLE_CLIENT_ID in backend/.env
# Get a Client ID at https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=

# JWT Configuration
REACT_APP_JWT_STORAGE_KEY=smartcart_token
REACT_APP_JWT_EXPIRATION_KEY=smartcart_token_exp

# API Configuration
REACT_APP_REQUEST_TIMEOUT=30000
REACT_APP_PAGINATION_LIMIT=20

# Feature Flags
REACT_APP_ENABLE_RECOMMENDATIONS=true
REACT_APP_ENABLE_ANALYTICS=true
