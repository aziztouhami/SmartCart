REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_API_VERSION=v1
REACT_APP_ENVIRONMENT=development
REACT_APP_DEBUG=true

# JWT Configuration
REACT_APP_JWT_STORAGE_KEY=smartcart_token
REACT_APP_JWT_EXPIRATION_KEY=smartcart_token_exp

# API Configuration
REACT_APP_REQUEST_TIMEOUT=30000
REACT_APP_PAGINATION_LIMIT=20

# Feature Flags
REACT_APP_ENABLE_RECOMMENDATIONS=true
REACT_APP_ENABLE_ANALYTICS=true
